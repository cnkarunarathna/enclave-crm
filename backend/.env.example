# Which settings module to load: config.settings.dev (local) or config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
# Signs sessions and JWTs. REQUIRED in prod, at least 50 random chars:
# uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-in-real-environments
# Debug mode; always False in prod (prod.py enforces it)
DJANGO_DEBUG=True
# Comma-separated host names this server answers to
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL connection URL (5433 = host port of the docker compose db)
DATABASE_URL=postgres://crm:crm@localhost:5433/crm
# Comma-separated frontend origins allowed to call the API (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated origins trusted for CSRF (Django admin via the frontend host)
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Access token lifetime in minutes
JWT_ACCESS_MINUTES=15
# Refresh token lifetime in days
JWT_REFRESH_DAYS=7
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Maximum company logo upload size in megabytes
MAX_LOGO_SIZE_MB=2
# --- Storage: set USE_S3=True and fill the rest to use S3; otherwise local media/ is used ---
USE_S3=False
# Private S3 bucket that stores company logos
AWS_STORAGE_BUCKET_NAME=
# Bucket region, e.g. ap-south-1
AWS_S3_REGION_NAME=
# Leave EMPTY in prod on EC2/ECS: boto3 uses the instance/task IAM role
AWS_ACCESS_KEY_ID=
# Leave EMPTY in prod on EC2/ECS
AWS_SECRET_ACCESS_KEY=
# Lifetime of presigned logo URLs in seconds
AWS_QUERYSTRING_EXPIRE=300
