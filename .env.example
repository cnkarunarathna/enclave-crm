# Read by docker compose (both stacks) for the Postgres container.
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm

# --- Only for docker-compose.prod.yml -------------------------------------
# Signs sessions and JWTs; required there. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Host names the prod-style stack answers to (default: localhost,127.0.0.1)
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
